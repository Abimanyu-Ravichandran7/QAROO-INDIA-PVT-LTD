# Dependencies
node_modules/

# Build output
dist/

# Uploaded candidate resumes — never commit personal data
backend/uploads/

# Environment & secrets
backend/.env
*.local

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Vite
*.local

# Local tooling config
compass-connections.json

# Stray / backup leftovers
*.bak
ChatGPT Image*.png

# Database dumps - contain job applications and contact messages (personal data)
backend/backups/

# Environment files. Only backend/.env was listed before, so a root .env or a
# backend/.env.production would have been committed. Patterns without a slash
# match at any depth; the negations keep the checked-in templates tracked.
.env
.env.*
!.env.example
!.env.*.example
