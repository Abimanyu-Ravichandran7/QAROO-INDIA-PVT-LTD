# Qaroo India — PRODUCTION environment template
# Copy to backend/.env on the server, fill every value below, delete this header.
# backend/.env is gitignored. Never commit real secrets.

# --- Server ---
PORT=5000
NODE_ENV=production

# --- Database (MongoDB Atlas) ---
# From: Atlas -> Cluster -> Connect -> Drivers. Replace <dbUser>/<dbPassword>
# with your DB user (not the app login) and keep the /qaroo_cms database name.
MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@<cluster>...</qaroo_cms

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- SMTP (Gmail app password, not your normal password) ---
# Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=
EMAIL_FROM=Qaroo Admin <no-reply@qarootech.in>

# --- Public site (no trailing slash) ---
CLIENT_URL=https://www.qarootech.in

# --- Cloudinary (dashboard credentials) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Deployment shape ---
# One host (API + built site together):   SERVE_STATIC=true
# Frontend hosted separately (CDN/GoDaddy): remove/leave unset + see repo /api note
SERVE_STATIC=true

# --- Seed-only: first Super Admin (idempotent; change password after login) ---
ADMIN_NAME=Qaroo Super Admin
ADMIN_EMAIL=admin@qarootech.in
ADMIN_PASSWORD=