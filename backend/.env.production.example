# Qaroo India — PRODUCTION environment template
# Copy to backend/.env on the server, fill every value below, delete this header.
# backend/.env is gitignored. Never commit real secrets.

# --- Server ---
PORT=5000
NODE_ENV=production

# --- Database (MongoDB Atlas) ---
# From: Atlas -> Cluster -> Connect -> Drivers. Replace <dbUser>/<dbPassword>
# with your DB user (not the app login) and keep the /qaroo_cms database name.
MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@<cluster>...</qaroo_cms

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- SMTP ---
# Verify any of these with: node tools/check-mail.mjs
# It authenticates without sending; add --send=<address> for a real test.
#
# PREFERRED - a transactional relay (Brevo shown; Resend, Mailgun and SendGrid
# are equivalent). The credential is a send-only SMTP key: it cannot read mail,
# and revoking it breaks nothing else. Requires verifying qaroo.in once by
# adding the SPF and DKIM records the provider gives you to GoDaddy DNS -
# without that, mail sent as your domain is filtered as spam.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Qaroo India <support@qaroo.in>

# FALLBACK - the mailbox's own password, via GoDaddy (qaroo.in MX points at
# secureserver.net). It works, but that one password grants full control of the
# mailbox: reading mail, sending as the domain, and receiving password resets.
# GoDaddy offers no scoped or separately revocable credential, so prefer the
# relay above for anything production-facing.
#   EMAIL_HOST=smtpout.secureserver.net
#   EMAIL_PORT=465
#   EMAIL_SECURE=true
#   EMAIL_USER=support@qaroo.in
#   EMAIL_PASSWORD=
#   EMAIL_FROM=Qaroo India <support@qaroo.in>
#
# Note on ports: 465 pairs with EMAIL_SECURE=true (implicit TLS), 587 with
# false (STARTTLS). Crossing them hangs or fails with a confusing TLS error.
#
# Gmail is not suitable here: a normal password will not authenticate, it needs
# a 16-character App Password, and it cannot send as your own domain.

# --- Public site (no trailing slash) ---
# Comma-separate every origin the browser will actually use, including the
# apex/www variant you do NOT redirect away, or credentialed requests from it
# are refused with "Not allowed by CORS". The server refuses to start in
# production if this is empty, localhost-only, or non-HTTPS.
CLIENT_URL=https://www.qaroo.in,https://qaroo.in

# --- Cookie scope ---
# Leave unset (defaults to "lax") when the site and the API share a registrable
# domain - qaroo.in with api.qaroo.in counts as one site.
# Set to "none" ONLY if they are genuinely cross-site, e.g. the frontend on
# *.vercel.app calling an API on qaroo.in. With "lax" in that setup the browser
# withholds the cookie on fetches and admin login appears to work, then
# immediately logs out. "none" forces Secure, so it requires HTTPS on both.
# COOKIE_SAMESITE=none

# --- Cloudinary (dashboard credentials) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Deployment shape ---
# One host (API + built site together):   SERVE_STATIC=true
# Frontend hosted separately (CDN/GoDaddy): remove/leave unset + see repo /api note
SERVE_STATIC=true

# --- Seed-only: first Super Admin (idempotent; change password after login) ---
ADMIN_NAME=Qaroo Super Admin
ADMIN_EMAIL=admin@qarootech.in
ADMIN_PASSWORD=